# Kaguya as a *user* background service (no root needed).
# Install steps are in README.md -> "Run Kaguya in the background".
[Unit]
Description=Kaguya moonlit host security monitor
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=%h/Kaguya
# loads the SMTP key (CS_SMTP_PASSWORD) from the private file, then starts Kaguya
ExecStart=/bin/bash -c '. %h/.config/kaguya/smtp.env; exec %h/.local/bin/kaguya run'
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
