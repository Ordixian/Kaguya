# Kaguya as a *user* background service (no root needed).
# Install steps are in docs/background-service.md.
[Unit]
Description=Kaguya moonlit host security monitor
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=%h/Kaguya
# loads the SMTP key (if the file exists) (CS_SMTP_PASSWORD) from the private file, then starts Kaguya
ExecStart=/bin/bash -c '[ -f %h/.config/kaguya/smtp.env ] && . %h/.config/kaguya/smtp.env; exec %h/.local/bin/kaguya run'
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
